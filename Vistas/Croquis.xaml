<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modelos="clr-namespace:Menushell401.Modelos"
             x:Class="Menushell401.Vistas.Croquis"
             Title="Croquis"
             BackgroundColor="White">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="16"
                             MaximumWidthRequest="900" HorizontalOptions="Center">

            <Label Text="Croquis del campus" FontSize="28" FontAttributes="Bold"
                   TextColor="#1A1A1A" HorizontalOptions="Center" />
            <!-- Dirección del campus -->
            <Border Padding="16" StrokeThickness="0" BackgroundColor="#FAFAFA"
                    StrokeShape="RoundRectangle 16">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.12" Radius="8" Offset="0,3" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Label Text="🎓 Universidad Politécnica del Valle de México"
                           FontSize="18" FontAttributes="Bold" />
                    <Label Text="Av. Mexiquense s/n, esq. Av. Universidad Politécnica, C.P. 54910, Tultitlán, Estado de México"
                           FontSize="14" TextColor="#555555" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Ver en Google Maps" BackgroundColor="#D32F2F"
                                TextColor="White" CornerRadius="10" Clicked="CampusMapa_Clicked" />
                        <Button Grid.Column="1" Text="Cómo llegar" BackgroundColor="#0A64C8"
                                TextColor="White" CornerRadius="10" Clicked="CampusRuta_Clicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- Mi ubicación (igual que en clase: latitud y longitud) -->
            <Border Padding="16" StrokeThickness="0" BackgroundColor="#FAFAFA"
                    StrokeShape="RoundRectangle 16">
                <Border.Shadow>
                    <Shadow Brush="Black" Opacity="0.12" Radius="8" Offset="0,3" />
                </Border.Shadow>
                <VerticalStackLayout Spacing="8">
                    <Label Text="📍 Mi ubicación" FontSize="18" FontAttributes="Bold" />
                    <Grid ColumnDefinitions="Auto,*,Auto,*" ColumnSpacing="8">
                        <Label Text="Latitud:" TextColor="#555555" />
                        <Label Grid.Column="1" x:Name="lat" Text="—" />
                        <Label Grid.Column="2" Text="Longitud:" TextColor="#555555" />
                        <Label Grid.Column="3" x:Name="lon" Text="—" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
                        <Button Text="Actualizar" BackgroundColor="#757575" TextColor="White"
                                CornerRadius="10" Clicked="Actualizar_Clicked" />
                        <Button Grid.Column="1" Text="Ver en el mapa" BackgroundColor="#D32F2F"
                                TextColor="White" CornerRadius="10" Clicked="MiMapa_Clicked" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <Label Text="Lugares del campus" FontSize="20" FontAttributes="Bold" />

            <VerticalStackLayout Spacing="14" BindableLayout.ItemsSource="{Binding Lugares}">

                <BindableLayout.EmptyView>
                    <Label Text="No se pudieron cargar los lugares" TextColor="#757575"
                           HorizontalOptions="Center" Margin="0,20" />
                </BindableLayout.EmptyView>

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="modelos:Lugar">
                        <Border Padding="0" StrokeThickness="0" BackgroundColor="White"
                                StrokeShape="RoundRectangle 16">
                            <Border.Shadow>
                                <Shadow Brush="Black" Opacity="0.15" Radius="8" Offset="0,3" />
                            </Border.Shadow>
                            <Grid ColumnDefinitions="8,*">
                                <BoxView Color="#D32F2F" />
                                <VerticalStackLayout Grid.Column="1" Padding="16" Spacing="4">
                                    <Label Text="{Binding Nombre}" FontSize="20" FontAttributes="Bold"
                                           TextColor="#212121" />
                                    <Label Text="{Binding Descripcion}" FontSize="14" TextColor="#616161" />
                                    <Label Text="{Binding DistanciaTexto}" FontSize="13"
                                           FontAttributes="Bold" TextColor="#2E7D32" />
                                    <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="0,8,0,0">
                                        <Button Text="Ver en mapa" BackgroundColor="#D32F2F"
                                                TextColor="White" CornerRadius="10"
                                                Clicked="VerLugar_Clicked" />
                                        <Button Grid.Column="1" Text="Cómo llegar 🚶" BackgroundColor="#0A64C8"
                                                TextColor="White" CornerRadius="10"
                                                Clicked="ComoLlegar_Clicked" />
                                    </Grid>
                                </VerticalStackLayout>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </BindableLayout.ItemTemplate>
            </VerticalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>