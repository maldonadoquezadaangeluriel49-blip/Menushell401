<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modelos="clr-namespace:Menushell401.Modelos"
             x:Class="Menushell401.Vistas.Noticias"
             BackgroundColor="White">

    <Grid>
        <Image Source="bacground.jpg"
               Aspect="AspectFill"
               Opacity="0.30" />

        <RefreshView x:Name="refresh"
                     Refreshing="OnRefresh"
                     RefreshColor="#D32F2F"
                     BackgroundColor="Transparent">

            <ScrollView BackgroundColor="Transparent">

                <VerticalStackLayout Spacing="24" Padding="20"
                                     MaximumWidthRequest="900"
                                     HorizontalOptions="Center">

                    <Label Text="Sección de Noticias"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="#1A1A1A"
                           HorizontalOptions="Center" />

                    <Label Text="Explora las publicaciones y novedades del Diario UPVM"
                           FontSize="17"
                           TextColor="#444444"
                           HorizontalTextAlignment="Center" />

                    <VerticalStackLayout Spacing="20"
                                         BindableLayout.ItemsSource="{Binding MisNoticias}">

                        <BindableLayout.EmptyView>
                            <VerticalStackLayout HorizontalOptions="Center" Spacing="8" Padding="30">
                                <Label Text="📰" FontSize="48" HorizontalTextAlignment="Center" />
                                <Label Text="No hay noticias por ahora"
                                       FontSize="16" TextColor="#757575"
                                       HorizontalTextAlignment="Center" />
                            </VerticalStackLayout>
                        </BindableLayout.EmptyView>

                        <BindableLayout.ItemTemplate>
                            <DataTemplate x:DataType="modelos:Noticia">

                                <Border BackgroundColor="White"
                                        Stroke="Transparent"
                                        StrokeShape="RoundRectangle 18"
                                        Padding="0">
                                    <Border.Shadow>
                                        <Shadow Brush="Black" Opacity="0.18" Radius="10" Offset="0,4" />
                                    </Border.Shadow>

                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnNoticiaTapped" />
                                    </Border.GestureRecognizers>

                                    <Grid ColumnDefinitions="8,*">
                                        <BoxView Color="#D32F2F" />

                                        <VerticalStackLayout Grid.Column="1" Spacing="0">

                                            <Image Source="{Binding Imagen}"
                                                   IsVisible="{Binding TieneImagen}"
                                                   HeightRequest="300"
                                                   Aspect="AspectFill" />

                                            <VerticalStackLayout Padding="20" Spacing="8">
                                                <Label Text="{Binding Titulo}"
                                                       FontSize="22"
                                                       FontAttributes="Bold"
                                                       TextColor="#212121"
                                                       MaxLines="2"
                                                       LineBreakMode="TailTruncation" />

                                                <Label Text="{Binding Descripcion}"
                                                       FontSize="16"
                                                       TextColor="#616161"
                                                       LineHeight="1.35"
                                                       MaxLines="3"
                                                       LineBreakMode="TailTruncation" />

                                                <Label Text="Leer más  ›"
                                                       FontSize="15"
                                                       FontAttributes="Bold"
                                                       TextColor="#D32F2F"
                                                       Margin="0,6,0,0" />
                                            </VerticalStackLayout>
                                        </VerticalStackLayout>
                                    </Grid>
                                </Border>

                            </DataTemplate>
                        </BindableLayout.ItemTemplate>

                    </VerticalStackLayout>

                </VerticalStackLayout>
            </ScrollView>
        </RefreshView>
    </Grid>
</ContentPage>