<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:modelos="clr-namespace:Menushell401.Modelos"
             x:Class="Menushell401.Vistas.Noticias"
             Title="Noticias">

    <CollectionView x:Name="listaNoticias" Margin="15">
        <CollectionView.ItemTemplate>
            <DataTemplate x:DataType="modelos:Noticia">
                <Frame Margin="0,5" Padding="12">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="{Binding Titulo}" FontSize="18" FontAttributes="Bold" />
                        <Label Text="{Binding Descripcion}" FontSize="14" />
                    </VerticalStackLayout>
                </Frame>
            </DataTemplate>
        </CollectionView.ItemTemplate>
    </CollectionView>
</ContentPage>